# ─── Server Configuration ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fleetwise?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookie Security ───────────────────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET
COOKIE_SECURE=false        # Set to true in production (HTTPS only)
COOKIE_SAME_SITE=lax       # Use 'strict' in production

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@fleetwise.app
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=FleetWise <no-reply@fleetwise.app>

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ─── App URL (for emails and redirects) ───────────────────────────────────────
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# ─── Optional: Sentry DSN for error tracking ─────────────────────────────────
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
